# Main Telegram bot token from @BotFather
BOT_TOKEN=your_main_telegram_bot_token_here

# Second Telegram bot token, used by /dual mode
BOT_TOKEN_2=your_second_telegram_bot_token_here

# Telegram Bot API endpoint (cloud API or local sidecar)
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_API_IS_LOCAL=0

# Telegram API ID/Hash from my.telegram.org — required only for local Bot API server
TELEGRAM_API_ID=your_telegram_api_id_here
TELEGRAM_API_HASH=your_telegram_api_hash_here

# ── Access control, chats, and owner identity ─────────────────────────────
CHAT_ID=0
TEXT_ONLY_CHAT_ID=0
FULL_ACCESS_CHAT_ID=0
STICKER_CHAT_ID=0
ALLOWED_USER_IDS=
BANNED_USER_IDS=
OWNER_USER_ID=0
OWNER_ALT_IDS=
ADMIN_IDS=
OWNER_NAME=Owner
OWNER_USERNAME=
OWNER_ALIASES=
BOT_DISPLAY_NAME=Hatani AI
BOT_USERNAMES=
BOT2_USERNAME=

# ── OmniRoute gateway (primary Agent & Vision provider) ───────────────────
OMNIROUTE_BASE_URL=http://your-omniroute-host:20128/v1
OMNIROUTE_API_KEY=your_omniroute_api_key_here
OMNIROUTE_AGENT_MODEL=agy/gemini-4-hydrogen-low
# Empty means use OMNIROUTE_AGENT_MODEL for vision too.
OMNIROUTE_VISION_MODEL=
OMNIROUTE_APP_TITLE=NanoHatani

# ── API keys (KeyHunter pool + optional overrides) ────────────────────────
# Most provider keys (Gemini, OpenAI, Nvidia, OpenRouter, Replicate, Groq,
# DeepSeek, ElevenLabs, Firecrawl, Suno) are read live from KEYHUNTER_DB.
FIRECRAWL_API_KEY=
FIRECRAWL_KEYS=
OPENAI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Figma Personal Access Token and bridge secret (for /figma command)
FIGMA_TOKEN=figd_your_figma_token_here
FIGMA_API_BASE_URL=https://api.figma.com/v1
FIGMA_BRIDGE_SECRET=change_me_to_random_secret
FIGMA_BRIDGE_HOST=0.0.0.0
FIGMA_BRIDGE_PORT=7432

# Encryption key for sensitive data at rest (Veo API keys in SQLite).
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DB_ENCRYPTION_KEY=

# Telegram username and optional instructions for payment contact
PAYMENT_USERNAME=your_username
PAYMENT_INFO=

# Optional provider credentials. Keep real values only in .env, never in source control.
MVSEP_API_TOKEN=
MVSEP_BASE_URL=https://mvsep.com/api

# OpenRouter endpoint/model overrides
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
OPENROUTER_VISION_MODEL=
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image-preview
OPENROUTER_APP_TITLE=NanoHatani

# Storage and runtime path overrides
KEYHUNTER_DB=/root/keyhunter/keyhunter.db
DB_PATH=bot_data.db
NANO_KEYS_DB=nano_keys.db
BOT_LOG_PATH=bot.log
AGENT_SANDBOX_USER=hatani
AGENT_WORKSPACE_BASE=/home/hatani/workspaces
PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers
COOKIES_DIR=/root/cookies
UPSCALE_MODEL_DIR=models/upscale
RANDOM_GIF_DIR=media/random_gifs

# Provider endpoint/model overrides
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MULTIMODAL_MODEL=gemini-3.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
VEO_DEFAULT_MODEL=veo-2.0-generate-001
OMNI_VIDEO_MODEL=gemini-omni-1.1-flash
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_FALLBACK_MODEL=gpt-image-1.5
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
NVIDIA_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
NVIDIA_IMAGE_MODEL=black-forest-labs/flux.1-schnell
NVIDIA_VISION_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
REPLICATE_BASE_URL=https://api.replicate.com/v1
REPLICATE_DEFAULT_MODEL=aisha-ai-official/wai-nsfw-illustrious-v12
SUNO_BASE_URL=https://api.sunoapi.org/api/v1
SUNO_UPLOAD_BASE_URL=https://sunoapiorg.redpandaai.co
SUNO_PLACEHOLDER_CALLBACK=https://example.com/suno-callback
FIRECRAWL_SEARCH_URL=https://api.firecrawl.dev/v2/search
FIRECRAWL_SCRAPE_URL=https://api.firecrawl.dev/v2/scrape
JINA_READER_BASE_URL=https://r.jina.ai
REDIS_URL=redis://localhost:6379

# Random chat media / stickers
KIRIESHKI_STICKER_SET=kirieshkikirieshki
PERMA_STICKER_SET=SHCHperma9740
KIRIESHKI_STICKER_CHANCE=0.003
PERMA_STICKER_CHANCE=0.003
RANDOM_GIF_CHANCE=0.004

# Auto-voice settings
AUTO_VOICE_TTS_MODEL=eleven_v3
AUTO_VOICE_KEYWORDS=hutao,хутао,hu tao
AUTO_VOICE_CAPTION=Hu Tao

# Docker Compose health-check timings
TELEGRAM_API_HEALTH_INTERVAL=10s
TELEGRAM_API_HEALTH_TIMEOUT=5s
TELEGRAM_API_HEALTH_RETRIES=5
TELEGRAM_API_HEALTH_START_PERIOD=10s

# Omni Flash video editing proxy (required for EEA bypass).
# Format: socks5://user:pass@host:port or http://host:port
OMNI_PROXY=
